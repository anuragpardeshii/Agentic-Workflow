# Copy to .env for Compose. For native development, copy to backend/.env.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h
# Dedicated 32-byte base64 secret for user API keys. make setup generates it.
API_KEY_ENCRYPTION_KEY=
MONGO_URI=mongodb://localhost:27017/buildfast
FRONTEND_URL=http://localhost:5173
PORT=3000
AI_PROVIDER=ollama
AI_MODEL=qwen2.5-coder:7b
AI_FREE_ONLY=true
AI_MAX_OUTPUT_TOKENS=8192
AI_MAX_INPUT_CHARS=24000
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_URL=http://localhost:11434
# Optional free hosted provider: AI_PROVIDER=openrouter, AI_MODEL=openrouter/free
# Use a free account without purchased credits; quotas and availability apply.
OPENROUTER_API_KEY=
# Legacy Groq requires AI_FREE_ONLY=false; its account billing cannot be enforced here.
GROQ_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Buildfast <hello@localhost>
CONTACT_TO=team@localhost
SMTP_USER=
SMTP_PASS=

# Docker host ports (internal container ports stay fixed)
FRONTEND_PORT=5174
API_PORT=3001
